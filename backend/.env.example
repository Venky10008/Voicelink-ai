[TEMPLATE]
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Supabase Postgres (async)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Demo mode ─────────────────────────────────────────────────────────────
# DEMO_MODE=true → every voice reply is spoken by Microsoft Edge TTS (fast,
# reliable, free) and the local cloning engines (Chatterbox/OmniVoice/XTTS)
# are skipped entirely — the call can never hang inside a GPU model. Cloned
# "My Voice" profiles stay selectable in the UI and simply route through
# Edge TTS behind the scenes. Recommended for live demos.
DEMO_MODE=false

# ── Speech ────────────────────────────────────────────────────────────────
# Local Whisper model for voice-call transcription.
# "large-v3-turbo" is RECOMMENDED — 4x faster than large-v3 with 95% accuracy.
# Much better for Telugu/Hindi than "small". First voice call downloads ~809 MB.
# Options: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# Default Edge TTS voices used when no explicit voice is chosen and the reply
# language is auto-detected from the text (English / Hindi / Telugu).
# DEFAULT_EDGE_TTS_VOICE=en-US-AriaNeural
# HINDI_EDGE_TTS_VOICE=hi-IN-MadhurNeural
# TELUGU_EDGE_TTS_VOICE=te-IN-ShrutiNeural

# ── Voice cloning ─────────────────────────────────────────────────────────
# The system auto-selects: OmniVoice (preferred) → XTTS v2 (fallback) → Edge TTS.
# Install OmniVoice (recommended, 600+ languages, Apache 2.0):
#   pip install omnivoice torch torchaudio
# For NVIDIA GPU: pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu128
# For CPU-only:   pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
#
# OmniVoice config:
# OMNIVOICE_MODEL=k2-fsa/OmniVoice    # HuggingFace model ID
# OMNIVOICE_DEVICE=auto               # auto / cuda / mps / cpu
#
# XTTS v2 fallback (requires Python 3.11/3.12 + coqui-tts):
# XTTS_LANGUAGE=en
# XTTS_GPU=0            # force CPU
# VOICE_CLONE_DATA_DIR=data/cloned_voices
#
# ── Remote Colab GPU (Chatterbox) ─────────────────────────────────────────
# Offload Chatterbox TTS to a free Colab T4 GPU via ngrok tunnel.
# Steps:
#   1. Upload colab_chatterbox_server.ipynb to Google Colab
#   2. Set runtime to T4 GPU, run all cells
#   3. Copy the ngrok URL from the output
#   4. Paste below (the URL changes on Colab restart)
# COLAB_TTS_URL=https://XXXX.ngrok-free.app
# COLAB_TTS_TIMEOUT=120   # seconds before giving up on Colab response
